# ==============================================================================
# RENDER WEB SERVICE ENVIRONMENT VARIABLES
# ==============================================================================
# You can copy and paste the lines below directly into Render's Environment tab.
# Render -> your Web Service ("linksnip-api") -> Environment -> Add from .env / Bulk Editor

# Spring Profile
SPRING_PROFILES_ACTIVE=docker

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL - Neon.tech recommended for lifetime free)
# ------------------------------------------------------------------------------
# If using Neon: replace YOUR_NEON_HOST, USERNAME, and PASSWORD with your Neon values:
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_HOST/linksnip?sslmode=require
DB_USERNAME=linksnip_owner
DB_PASSWORD=YOUR_NEON_PASSWORD

# (Alternative) If using Render's internal PostgreSQL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://linksnip-db:5432/linksnip
# DB_USERNAME=linksnip
# DB_PASSWORD=YOUR_RENDER_DB_PASSWORD

# ------------------------------------------------------------------------------
# 2. REDIS CACHE & RATE LIMITING
# ------------------------------------------------------------------------------
# If using Render's Internal Redis:
REDIS_HOST=linksnip-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# (Alternative) If using Upstash Redis (lifetime free):
# REDIS_HOST=YOUR_UPSTASH_ENDPOINT.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=YOUR_UPSTASH_PASSWORD
# REDIS_SSL_ENABLED=true

# ------------------------------------------------------------------------------
# 3. APPLICATION & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Set this to your public Render service URL:
APP_BASE_URL=https://linksnip-api.onrender.com

# CORS: Allows requests from your Vercel frontend or any domain
CORS_ALLOWED_ORIGINS=*

# JWT Signing Secret (must be at least 32 characters long)
JWT_SECRET=linksnip-production-secret-key-super-secure-32bytes-min!!

# Salt pepper for GDPR-compliant IP hashing
IP_HASH_PEPPER=linksnip-production-salt-pepper-random-secure-12345
